<div class="event-card">

<div class="event-time">

<%= event.start_time.strftime("%H:%M") %>

</div>

<h3 class="event-title">

<%= event.title %>

</h3>

<% if event.location.present? %>

<div class="event-location">

<%= event.location %>

</div>

<% end %>

<%= link_to "Подробнее", event_path(event), class:"event-link" %>

</div>