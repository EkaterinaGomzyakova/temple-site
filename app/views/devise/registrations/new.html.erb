<div class="auth-page">

  <h1 class="auth-title">Регистрация</h1>

  <%= form_for(resource,
      as: resource_name,
      url: registration_path(resource_name)) do |f| %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="auth-field">
      <p><%= f.label :name, "Имя" %></p>
      <p><%= f.text_field :name,
          autofocus: true,
          autocomplete: "name" %></p>
    </div>

    <div class="auth-field">
      <p><%= f.label :email, "Почта" %></p>
      <p><%= f.email_field :email,
          autocomplete: "email" %></p>
    </div>

    <div class="auth-field">
      <p><%= f.label :password, "Пароль" %></p>

      <% if @minimum_password_length %>
        <p class="auth-hint">
          минимум <%= @minimum_password_length %> символов
        </p>
      <% end %>

      <p><%= f.password_field :password,
          autocomplete: "new-password" %></p>
    </div>

    <div class="auth-field">
      <p><%= f.label :password_confirmation, "Повторите пароль" %></p>
      <p><%= f.password_field :password_confirmation,
          autocomplete: "new-password" %></p>
    </div>

    <div class="auth-actions">
      <%= f.submit "Зарегистрироваться", class: "auth-button" %>
    </div>

  <% end %>

  <div class="auth-links">
    <%= render "devise/shared/links" %>
  </div>

</div>