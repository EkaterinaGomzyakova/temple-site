<div class="auth-page">

  <h1 class="auth-title">Вход</h1>

  <%= form_for(resource, as: resource_name,
      url: session_path(resource_name)) do |f| %>

    <div class="auth-field">
      <p><%= f.label :email, "Почта" %></p>
      <p><%= f.email_field :email,
          autofocus: true,
          autocomplete: "email" %></p>
    </div>

    <div class="auth-field">
      <p><%= f.label :password, "Пароль" %></p>
      <p><%= f.password_field :password,
          autocomplete: "current-password" %></p>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="auth-remember">

        <%= f.check_box :remember_me %>

        <%= f.label :remember_me, "Запомнить меня" %>

      </div>
    <% end %>

    <div class="auth-actions">
      <%= f.submit "Войти", class: "auth-button" %>
    </div>

  <% end %>

  <div class="auth-links">
    <%= render "devise/shared/links" %>
  </div>

</div>