<section class="ruf-section">

  <div class="ruf-hero">
    <div class="ruf-title-description">
      <h1 class="ruf-title">Руфъ</h1>

      <p class="ruf-description">Объединение близких по духу людей,<br> прихожан Храма Святителя Николая на Трёх<br> Горах и их друзей</p>
    </div>


    <div class="ruf-list">

      <div class="ruf-block">
        <div class='block-left'>  
          <div class="ruf-number">1</div>
          <p class="ruf-text">ОБРАЗОВАТЕЛЬНЫЙ<br> ЦЕНТР</p>
        </div>
        <div class='block-right'>
          <div class="ruf-number">2</div>
          <p class="ruf-text">ЛАВКА<br> ПРИ ХРАМЕ</p>
        </div>
      </div>

      <div class="ruf-block">
        <div class='block-right'>
          <div class="ruf-number">4</div>
          <p class="ruf-text">КУЛЬТУРНОЕ<br> ПРОСТРАНСТВО</p>
        </div>
        <div class='block-left'> 
          <div class="ruf-number">3</div>
          <p class="ruf-text">КАФЕ<br> ПРИ ХРАМЕ</p>
        </div>
      </div>
        
    </div>

  </div>

    <div class="ruf-gallery">

      <div class="ruf-track">


          <%= image_tag "ruf/1.jpg", class: "ruf-image" %>
          <%= image_tag "ruf/2.jpg", class: "ruf-image" %>
          <%= image_tag "ruf/3.jpg", class: "ruf-image" %>
          <%= image_tag "ruf/4.jpg", class: "ruf-image" %>

        <!-- дублируем для бесконечной анимации -->


          <%= image_tag "ruf/1.jpg", class: "ruf-image" %>
          <%= image_tag "ruf/2.jpg", class: "ruf-image" %>
          <%= image_tag "ruf/3.jpg", class: "ruf-image" %>
          <%= image_tag "ruf/4.jpg", class: "ruf-image" %>

      </div>

    </div>

</section>


<div id="calendar-container">
  <%= render "calendar" %>
</div>

<%= javascript_include_tag "calendar" if Rails.env.development? %>





<section class="cultural-space-section">
  <div class="section-content">
    <h2 class="section-title">Культурное пространство</h2>
    <p class="section-description">
      Поддерживаем молодых авторов и даём сцену зрелым мастерам, соединяя традицию христианской культуры с языком современного искусства
    </p>
    <%= link_to "Подробнее", culture_path, class: "section-button" %>
  </div>
</section>

<section class="community-news-section">
  <div class="section-content">
    <h2 class="section-title">Новости сообщества</h2>
    <%= link_to "Подробнее", news_index_path, class: "section-button" %>

    <div class="news-grid">
        <% @latest_news.each do |news_item| %>
            <div class="news-card">
            <div class="news-header">
                <h3 class="news-title"><%= news_item.title %></h3>
                <% news_date = news_item.created_at %>
                <span class="news-date">
                <%= news_date.day %> 
                <%= I18n.t('date.abbr_month_names')[news_date.month] %> 
                <%= news_date.year %>
                </span>
            </div>
            <p class="news-excerpt"><%= truncate(strip_tags(news_item.content), length: 120) %></p>
            <%= link_to "Подробнее", news_path(news_item), class: "news-read-more" %>
            </div>
        <% end %>
    </div>
  </div>
  </section>

<section class="section-values">
  <div class="section-container">
    <h2 class="section-title">Наши ценности</h2>

    <div class="values-content">
      <div class="value-item">
        <h3 class="value-name">Профессионализм</h3>
        <p class="value-description">
          01
        </p>
      </div>

      <div class="value-item">
        <h3 class="value-name">Добровольчество и открытость</h3>
        <p class="value-description">
          02
        </p>
      </div>

      <div class="value-item">
        <h3 class="value-name">Традиции</h3>
        <p class="value-description">
          03
        </p>
      </div>

    </div>
</section>

<section class="section-help">
  <div class="section-container">
    <h2 class="section-title">Хотите помочь?</h2>

    <p class="help-text">
      Вы можете: (1) стать волонтёром, (2) поддержать донейшеном, (3) привести партнёров
    </p>
  </div>
</section>